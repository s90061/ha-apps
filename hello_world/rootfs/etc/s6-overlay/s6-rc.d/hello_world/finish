#!/usr/bin/env bashio
# shellcheck shell=bash
# ==============================================================================
# Handle hello_world service exit
# ==============================================================================

declare APP_EXIT_CODE="${1:-0}"

if [[ "${APP_EXIT_CODE}" -ne 0 ]] && [[ "${APP_EXIT_CODE}" -ne 256 ]]; then
  bashio::log.warning "Service exited unexpectedly with code ${APP_EXIT_CODE}, halting container"
  echo "${APP_EXIT_CODE}" > /run/s6-linux-init-container-results/exitcode
  exec /run/s6/basedir/bin/halt
fi

bashio::log.info "Hello World service stopped (exit code ${APP_EXIT_CODE})"
