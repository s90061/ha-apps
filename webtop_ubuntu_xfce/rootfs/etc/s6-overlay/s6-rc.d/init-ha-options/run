#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# ==============================================================================
# Bridge Home Assistant /data/options.json into s6 container_environment
# ==============================================================================

set -euo pipefail

ENV_DIR="/run/s6/container_environment"
OPTIONS_FILE="/data/options.json"

mkdir -p "${ENV_DIR}"

if [[ ! -f /proc/net/if_inet6 ]]; then
  printf 'true' > "${ENV_DIR}/DISABLE_IPV6"
fi

if [[ -r "${OPTIONS_FILE}" ]]; then
  python3 - "${OPTIONS_FILE}" "${ENV_DIR}" <<'PYEOF'
import json
import pathlib
import sys

options_path = pathlib.Path(sys.argv[1])
env_dir = pathlib.Path(sys.argv[2])

try:
    data = json.loads(options_path.read_text(encoding="utf-8"))
except Exception as exc:
    print(f"[ha-init] Warning: failed to parse {options_path}: {exc}", file=sys.stderr)
    sys.exit(0)

if not isinstance(data, dict):
    sys.exit(0)

mapping = {
    "tz": "TZ",
    "title": "TITLE",
    "lc_all": "LC_ALL",
    "puid": "PUID",
    "pgid": "PGID",
    "custom_user": "CUSTOM_USER",
    "password": "PASSWORD",
}

for opt_key, env_key in mapping.items():
    if opt_key not in data or data[opt_key] is None:
        continue
    val = str(data[opt_key])
    if opt_key in ("custom_user", "password", "tz", "title", "lc_all") and val.strip() == "":
        continue
    (env_dir / env_key).write_bytes(val.encode("utf-8"))
    if opt_key == "lc_all":
        (env_dir / "LANG").write_bytes(val.encode("utf-8"))
        lang_short = val.split(".", 1)[0]
        if lang_short:
            (env_dir / "LANGUAGE").write_bytes(lang_short.encode("utf-8"))
PYEOF
fi
