#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# ==============================================================================
# Map desktop Downloads folders and XDG_DOWNLOAD_DIR to Home Assistant /share
# ==============================================================================

set -euo pipefail

USER_NAME="abc"
USER_HOME="/config"
STATE_DIR="${USER_HOME}/.local/state"
STATE_FILE="${STATE_DIR}/ha-download-dir"
TARGET="${DOWNLOAD_DIR:-/share/downloads}"

while [[ "${TARGET}" != "/" && "${TARGET}" == */ ]]; do
  TARGET="${TARGET%/}"
done

if [[ -z "${TARGET}" || "${TARGET}" == "/" || "${TARGET}" == "${USER_HOME}" ]]; then
  echo "[ha-init] Warning: refusing unsafe download_dir '${TARGET}'" >&2
  exit 0
fi

if [[ "${TARGET}" == "/share" || "${TARGET}" == /share/* ]] && [[ ! -d /share ]]; then
  echo "[ha-init] /share is not mounted; skipping download directory mapping to ${TARGET}" >&2
  exit 0
fi

abc_uid="$(id -u "${USER_NAME}")"
abc_gid="$(id -g "${USER_NAME}")"

prev_target=""
if [[ -f "${STATE_FILE}" ]]; then
  prev_target="$(tr -d '\r\n' < "${STATE_FILE}" || true)"
fi

# Replace an old managed symlink if download_dir now points directly at that path
if [[ -L "${TARGET}" && -n "${prev_target}" ]] && [[ "$(readlink "${TARGET}" || true)" == "${prev_target}" ]]; then
  rm -f "${TARGET}"
fi

mkdir -p "${TARGET}"
if [[ "$(stat -c '%u:%g' "${TARGET}")" != "${abc_uid}:${abc_gid}" ]]; then
  chown "${abc_uid}:${abc_gid}" "${TARGET}" || true
fi

if ! s6-setuidgid "${USER_NAME}" test -w "${TARGET}" || ! s6-setuidgid "${USER_NAME}" test -x "${TARGET}"; then
  echo "[ha-init] Warning: ${USER_NAME} (${abc_uid}:${abc_gid}) cannot write to ${TARGET}; skipping symlink setup" >&2
  exit 0
fi

migrate_and_link() {
  local link_path="$1"

  if [[ "${link_path}" == "${TARGET}" ]]; then
    return 0
  fi

  if [[ -L "${link_path}" ]]; then
    local current
    current="$(readlink "${link_path}" || true)"
    if [[ "${current}" == "${TARGET}" ]]; then
      chown -h "${abc_uid}:${abc_gid}" "${link_path}" || true
      return 0
    fi
    if [[ ! -e "${link_path}" ]] || { [[ -n "${prev_target}" ]] && [[ "${current}" == "${prev_target}" ]]; }; then
      ln -sfn "${TARGET}" "${link_path}"
      chown -h "${abc_uid}:${abc_gid}" "${link_path}" || true
      return 0
    fi
    echo "[ha-init] Preserving custom symlink ${link_path} -> ${current}" >&2
    return 0
  fi

  if [[ -d "${link_path}" ]]; then
    local item base had_conflict=false
    shopt -s dotglob nullglob
    for item in "${link_path}"/*; do
      base="$(basename "${item}")"
      [[ "${base}" == "." || "${base}" == ".." ]] && continue
      if [[ -e "${TARGET}/${base}" || -L "${TARGET}/${base}" ]]; then
        echo "[ha-init] Skipping ${item}: ${TARGET}/${base} already exists" >&2
        had_conflict=true
      else
        mv -- "${item}" "${TARGET}/"
      fi
    done
    shopt -u dotglob nullglob

    if [[ "${had_conflict}" == "true" ]] || ! rmdir "${link_path}" 2>/dev/null; then
      echo "[ha-init] Warning: could not replace non-empty ${link_path}; conflicting files left untouched" >&2
      return 0
    fi
  elif [[ -e "${link_path}" ]]; then
    echo "[ha-init] Warning: ${link_path} exists as a regular file; skipping symlink" >&2
    return 0
  fi

  ln -s "${TARGET}" "${link_path}"
  chown -h "${abc_uid}:${abc_gid}" "${link_path}" || true
}

mkdir -p "${USER_HOME}/.config" "${STATE_DIR}"
chown "${abc_uid}:${abc_gid}" "${USER_HOME}/.local" "${USER_HOME}/.config" "${STATE_DIR}" || true

# Initialize XDG directories on a fresh profile before replacing the download dir
if command -v xdg-user-dirs-update >/dev/null 2>&1 && [[ ! -f "${USER_HOME}/.config/user-dirs.dirs" ]]; then
  s6-setuidgid "${USER_NAME}" env HOME="${USER_HOME}" LC_ALL="${LC_ALL:-zh_TW.UTF-8}" LANG="${LANG:-zh_TW.UTF-8}" xdg-user-dirs-update || true
fi

migrate_and_link "${USER_HOME}/Downloads"
migrate_and_link "${USER_HOME}/下載"

if command -v xdg-user-dirs-update >/dev/null 2>&1; then
  s6-setuidgid "${USER_NAME}" env HOME="${USER_HOME}" LC_ALL="${LC_ALL:-zh_TW.UTF-8}" LANG="${LANG:-zh_TW.UTF-8}" xdg-user-dirs-update --set DOWNLOAD "${TARGET}" || true
fi

if [[ -f "${USER_HOME}/.config/user-dirs.dirs" ]]; then
  chown "${abc_uid}:${abc_gid}" "${USER_HOME}/.config/user-dirs.dirs" || true
fi

printf '%s\n' "${TARGET}" > "${STATE_FILE}"
chown "${abc_uid}:${abc_gid}" "${STATE_FILE}" || true
